# ==============================================
# Kutlu101 Environment Variables
# ==============================================
# Copy this file to .env and update with your values

# ==============================================
# Server Configuration
# ==============================================
PORT=3001
NODE_ENV=production

# ==============================================
# Client Configuration
# ==============================================
# Frontend server URL for socket.io connection
# For local development: http://localhost:3001
# For production: https://your-domain.com
VITE_SERVER_URL=http://localhost:3001

# ==============================================
# Optional: Client Port (for docker-compose)
# ==============================================
# Default is 80, change if you need a different port
# CLIENT_PORT=8080
